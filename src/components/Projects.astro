---
import { projects, site } from '../data/content';
const panel = ['bg-[color-mix(in_srgb,var(--accent)_16%,var(--surface))]', 'bg-[color-mix(in_srgb,var(--sun)_40%,var(--surface))]', 'bg-bg'];
---
<section id="projects" class="mx-auto max-w-6xl scroll-mt-24 px-5 py-16">
  <p class="font-mono text-sm text-accent">{projects.eyebrow}</p>
  <h2 class="mt-2 max-w-[22ch] font-display text-4xl font-bold tracking-tight sm:text-5xl">{projects.heading}</h2>
  <div class="mt-10 space-y-8">
    {projects.items.map((p, i) => (
      <article class="card grid overflow-hidden md:grid-cols-2">
        <div class={`grid place-items-center border-b-2 border-ink p-8 md:border-b-0 ${i % 2 ? 'md:order-2 md:border-l-2' : 'md:border-r-2'} ${panel[i]}`}>
          <svg viewBox="0 0 320 200" class="w-full max-w-sm" fill="none" stroke="var(--ink)" stroke-width="2.5" role="img" aria-label={`${p.title} illustration`}>
            {i === 0 && <g font-family="JetBrains Mono Variable, monospace" font-size="13">
              <rect x="20" y="20" width="280" height="40" rx="8" fill="var(--surface)"/><text x="36" y="45" fill="var(--ink)" stroke="none">GET /students</text><rect x="236" y="30" width="52" height="20" rx="5" fill="var(--accent)"/>
              <rect x="20" y="80" width="280" height="40" rx="8" fill="var(--surface)"/><text x="36" y="105" fill="var(--ink)" stroke="none">POST /tasks</text><rect x="236" y="90" width="52" height="20" rx="5" fill="var(--sun)"/>
              <rect x="20" y="140" width="280" height="40" rx="8" fill="var(--surface)"/><text x="36" y="165" fill="var(--ink)" stroke="none">PUT /tasks/1</text><rect x="236" y="150" width="52" height="20" rx="5" fill="var(--accent)"/></g>}
            {i === 1 && <g>
              <rect x="20" y="20" width="280" height="150" rx="8" fill="var(--surface)"/><rect x="20" y="20" width="280" height="30" rx="8" fill="var(--accent)"/>
              <path d="M20 80h280M20 110h280M20 140h280M110 20v150M200 20v150"/><rect x="112" y="82" width="86" height="27" fill="var(--sun)" stroke="none"/><rect x="202" y="112" width="96" height="27" fill="var(--sun)" stroke="none"/>
              <rect x="20" y="176" width="64" height="18" rx="4" fill="var(--surface)"/><rect x="90" y="176" width="64" height="18" rx="4" fill="var(--bg)"/></g>}
            {i === 2 && <g>
              <rect x="20" y="16" width="280" height="168" rx="10" fill="var(--surface)"/><path d="M20 46h280"/><circle cx="38" cy="31" r="4" fill="var(--ink)"/><circle cx="52" cy="31" r="4" fill="var(--ink)"/><circle cx="66" cy="31" r="4" fill="var(--ink)"/>
              <rect x="36" y="62" width="120" height="14" rx="3" fill="var(--accent)"/><rect x="36" y="86" width="170" height="8" rx="3"/><rect x="36" y="102" width="140" height="8" rx="3"/>
              <rect x="36" y="128" width="76" height="40" rx="6" fill="var(--sun)"/><rect x="122" y="128" width="76" height="40" rx="6"/><rect x="208" y="62" width="76" height="106" rx="6" fill="var(--bg)"/></g>}
          </svg>
        </div>
        <div class="flex flex-col p-7">
          <h3 class="font-display text-2xl font-bold leading-snug">{p.title}</h3>
          <p class="mt-3 leading-relaxed text-muted">{p.body}</p>
          <ul class="mt-5 flex flex-wrap gap-2 font-mono text-xs">
            {p.tags.map((t) => <li class="rounded-md border-2 border-ink px-2 py-1">{t}</li>)}
          </ul>
          <div class="mt-auto pt-6"><a href={site.github} class="btn btn-ghost">{projects.repo}</a></div>
        </div>
      </article>
    ))}
  </div>
</section>
