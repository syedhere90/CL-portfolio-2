---
import { site, nav, footer } from '../data/content';
const social = [['✉', `mailto:${site.email}`, 'Email'], ['📞', site.phoneHref, 'Phone'], ['💬', site.whatsapp, 'WhatsApp'], ['GH', site.github, 'GitHub'], ['IN', site.linkedin, 'LinkedIn']];
---
<footer class="mt-8 border-t-2 border-ink">
  <div class="mx-auto grid max-w-6xl gap-8 px-5 py-10 md:grid-cols-[1.2fr_1fr_auto] md:items-start">
    <div><p class="font-display text-xl font-bold">{site.name}</p><p class="mt-1 text-sm text-muted">{footer.tagline}</p></div>
    <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium">{nav.map((n) => <li><a href={n.href} class="hover:text-accent">{n.label}</a></li>)}</ul>
    <ul class="flex gap-2">{social.map(([icon, href, label]) => <li><a href={href} aria-label={label} class="grid h-10 w-10 place-items-center rounded-lg border-2 border-ink text-sm font-bold hover:bg-accent hover:text-on-accent">{icon}</a></li>)}</ul>
  </div>
  <div class="mx-auto max-w-6xl px-5 pb-8 text-sm text-muted"><p>{footer.copy}</p><p>{footer.built}</p></div>
</footer>
