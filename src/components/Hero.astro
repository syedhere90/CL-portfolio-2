---
import { hero } from '../data/content';
---
<section id="home" class="mx-auto grid max-w-6xl gap-10 px-5 pb-20 pt-14 lg:grid-cols-[1.1fr_1fr] lg:items-center lg:pt-20">
  <div class="rise">
    <p class="card inline-flex items-center !rounded-md px-3 py-1.5 font-mono text-sm !shadow-[3px_3px_0_var(--accent)]">{hero.badge}<span class="cursor" aria-hidden="true"></span></p>
    <h1 class="mt-6 max-w-[14ch] font-display text-5xl font-bold leading-[1.02] tracking-tight sm:text-6xl lg:text-7xl">{hero.headline}</h1>
    <p class="mt-6 max-w-[60ch] text-lg leading-relaxed text-muted">{hero.intro}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="#projects" class="btn btn-primary">{hero.buttons.work}</a>
      <a href="#cover-letter" class="btn btn-ghost">{hero.buttons.letter}</a>
      <a href="#contact" class="btn btn-ghost">{hero.buttons.contact}</a>
    </div>
  </div>
  <div class="rise grid grid-cols-2 gap-4" style="--d:.12s">
    <div class="card col-span-2 flex items-center gap-4 !bg-accent p-5 text-on-accent">
      <div class="grid h-16 w-16 shrink-0 place-items-center rounded-xl border-2 border-current font-display text-2xl font-bold" aria-hidden="true">SI</div>
      <ul class="flex flex-wrap gap-2 font-mono text-xs">
        {hero.tags.map((t) => <li class="rounded-md border-2 border-current px-2 py-1">{t}</li>)}
      </ul>
    </div>
    {hero.stats.map((s) => (
      <div class="card p-4"><p class="font-display text-2xl font-bold">{s.big}</p><p class="mt-1 text-sm text-muted">{s.small}</p></div>
    ))}
    <ul class="card col-span-2 space-y-2 p-5 text-sm">
      {hero.facts.map((f) => (
        <li class="flex gap-3"><span aria-hidden="true">{f.icon}</span>{f.href ? <a href={f.href} class="hover:text-accent">{f.text}</a> : <span>{f.text}</span>}</li>
      ))}
    </ul>
  </div>
</section>
