---
import { site, nav } from '../data/content';
---
<header class="sticky top-3 z-50 px-3 pt-3">
  <div class="relative mx-auto max-w-5xl">
    <nav aria-label="Main" class="card flex items-center justify-between gap-3 !rounded-full px-4 py-2">
      <a href="#home" class="flex items-center gap-2 font-display font-bold">
        <span class="grid h-8 w-8 place-items-center rounded-lg bg-accent text-sm text-on-accent" aria-hidden="true">SI</span>
        <span>{site.brand.name} <span class="font-mono text-xs font-normal text-muted">{site.brand.tag}</span></span>
      </a>
      <ul class="hidden items-center gap-6 text-sm font-medium md:flex">
        {nav.map((n) => <li><a href={n.href} class="hover:text-accent">{n.label}</a></li>)}
      </ul>
      <div class="flex items-center gap-2">
        <button id="theme-toggle" type="button" aria-label="Toggle dark mode" class="grid h-9 w-9 place-items-center rounded-full border-2 border-ink">
          <span class="dark:hidden" aria-hidden="true">🌙</span><span class="hidden dark:inline" aria-hidden="true">☀️</span>
        </button>
        <a href="#contact" class="btn btn-primary !px-3 !py-1.5 text-sm max-sm:hidden">Get in Touch</a>
        <button id="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menu" class="grid h-9 w-9 place-items-center rounded-full border-2 border-ink md:hidden">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M2 5h14M2 9h14M2 13h14"/></svg>
        </button>
      </div>
    </nav>
    <div id="mobile-menu" hidden class="card absolute inset-x-0 top-full mt-3 p-3 md:hidden">
      <ul class="font-display text-lg font-semibold">
        {nav.map((n) => <li><a href={n.href} class="block rounded-lg px-3 py-2.5 hover:bg-accent hover:text-on-accent">{n.label}</a></li>)}
        <li><a href="#contact" class="mt-1 block rounded-lg bg-accent px-3 py-2.5 text-on-accent sm:hidden">Get in Touch</a></li>
      </ul>
    </div>
  </div>
</header>
