---
import { coverLetter as c } from '../data/content';
const text = c.paragraphs.join('\n\n') + `\n\n${c.signoff} ${c.name}`;
---
<section id="cover-letter" class="mx-auto max-w-4xl scroll-mt-24 px-5 py-16">
  <p class="font-mono text-sm text-accent">{c.eyebrow}</p>
  <div class="mt-2 flex flex-wrap items-end justify-between gap-4">
    <h2 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">{c.heading}</h2>
    <button id="copy-letter" type="button" data-text={text} data-done="Copied ✓" class="btn btn-ghost">{c.copy}</button>
  </div>
  <article class="card mt-8 p-7 sm:p-10">
    <header class="flex flex-wrap items-start justify-between gap-3 border-b-2 border-dashed border-ink pb-5">
      <div><h3 class="font-display text-2xl font-bold">{c.name}</h3><p class="mt-1 text-sm text-muted">{c.role}</p></div>
      <p class="rounded-md bg-sun px-2 py-1 font-mono text-xs font-medium text-[#14161A]">{c.badge}</p>
    </header>
    <div class="mt-6 max-w-[68ch] space-y-4 leading-relaxed">
      {c.paragraphs.map((p) => <p>{p}</p>)}
      <p>{c.signoff}<br /><strong>{c.name}</strong></p>
    </div>
  </article>
</section>
